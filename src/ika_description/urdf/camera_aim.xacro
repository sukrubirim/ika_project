<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="aim_camera" params="parent x y z roll pitch yaw">
    <link name="aim_camera_link">
      <visual><geometry><box size="0.05 0.06 0.04"/></geometry><material name="red"><color rgba="0.9 0.05 0.05 1"/></material></visual>
      <collision><geometry><box size="0.05 0.06 0.04"/></geometry></collision>
      <inertial><mass value="0.12"/><inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00008"/></inertial>
    </link>
    <joint name="aim_camera_joint" type="fixed">
      <parent link="${parent}"/><child link="aim_camera_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
    </joint>
    <gazebo reference="aim_camera_link">
      <sensor name="aim_camera" type="camera">
        <update_rate>30</update_rate>
        <camera><horizontal_fov>0.70</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.05</near><far>40</far></clip></camera>
        <plugin name="aim_camera_controller" filename="libgazebo_ros_camera.so">
          <ros><namespace>/</namespace></ros>
          <camera_name>aim_camera</camera_name>
          <frame_name>aim_camera_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>