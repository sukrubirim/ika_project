<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${mass*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${mass*(x*x+z*z)/12}" iyz="0" izz="${mass*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="ika_base">
    <link name="base_footprint"/>
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${ground_clearance}" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
        <material name="dark_gray"><color rgba="0.12 0.12 0.12 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      </collision>
      <xacro:box_inertial mass="42.0" x="${base_length}" y="${base_width}" z="${base_height}"/>
    </link>

    <link name="upper_frame_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="1.05 0.65 0.06"/></geometry>
        <material name="metal"><color rgba="0.45 0.45 0.45 1"/></material>
      </visual>
      <collision><geometry><box size="1.05 0.65 0.06"/></geometry></collision>
      <xacro:box_inertial mass="4.0" x="1.05" y="0.65" z="0.06"/>
    </link>
    <joint name="upper_frame_joint" type="fixed">
      <parent link="base_link"/>
      <child link="upper_frame_link"/>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
    </joint>

    <gazebo reference="base_link"><material>Gazebo/DarkGrey</material></gazebo>
    <gazebo reference="upper_frame_link"><material>Gazebo/Grey</material></gazebo>
  </xacro:macro>
</robot>