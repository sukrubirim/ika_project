<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rear_camera" params="parent x y z roll pitch yaw">
    <link name="rear_camera_link">
      <visual><geometry><box size="0.06 0.08 0.05"/></geometry><material name="green"><color rgba="0 0.7 0.1 1"/></material></visual>
      <collision><geometry><box size="0.06 0.08 0.05"/></geometry></collision>
      <inertial><mass value="0.15"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    </link>
    <joint name="rear_camera_joint" type="fixed">
      <parent link="${parent}"/><child link="rear_camera_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
    </joint>
    <gazebo reference="rear_camera_link">
      <sensor name="rear_camera" type="camera">
        <update_rate>30</update_rate>
        <camera><horizontal_fov>1.396</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.05</near><far>80</far></clip></camera>
        <plugin name="rear_camera_controller" filename="libgazebo_ros_camera.so">
          <ros><namespace>/</namespace></ros>
          <camera_name>rear_camera</camera_name>
          <frame_name>rear_camera_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
