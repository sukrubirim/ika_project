# TEKNOFEST UPDATE: RViz acilinca Gazebo sensor topiclerini dogrudan incelemek icin LaserScan ve kamera displayleri eklendi.
Panels:
  - Class: rviz_common/Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LiDAR Scan
      Topic:
        Value: /scan
      Queue Size: 10
      Style: Points
      Size (m): 0.03
      Alpha: 1
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Front Camera
      Topic:
        Value: /front_camera/image_raw
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Rear Camera
      Topic:
        Value: /rear_camera/image_raw
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Aim Camera
      Topic:
        Value: /aim_camera/image_raw
  Enabled: true
  Global Options:
    Fixed Frame: base_link
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
