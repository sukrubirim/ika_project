<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="laser_pointer" params="parent x y z">
    <link name="pan_base_link"><visual><geometry><cylinder radius="0.07" length="0.04"/></geometry><material name="black"><color rgba="0 0 0 1"/></material></visual><collision><geometry><cylinder radius="0.07" length="0.04"/></geometry></collision><inertial><mass value="0.3"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial></link>
    <joint name="pan_base_joint" type="fixed"><parent link="${parent}"/><child link="pan_base_link"/><origin xyz="${x} ${y} ${z}" rpy="0 0 0"/></joint>

    <link name="pan_link"><visual><geometry><box size="0.12 0.08 0.08"/></geometry><material name="gray"><color rgba="0.5 0.5 0.5 1"/></material></visual><collision><geometry><box size="0.12 0.08 0.08"/></geometry></collision><inertial><mass value="0.25"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial></link>
    <joint name="pan_joint" type="revolute"><parent link="pan_base_link"/><child link="pan_link"/><origin xyz="0 0 0.05" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-1.57" upper="1.57" effort="8" velocity="1.5"/><dynamics damping="0.05" friction="0.02"/></joint>

    <link name="tilt_link"><visual><geometry><box size="0.18 0.05 0.05"/></geometry><material name="red"><color rgba="0.9 0 0 1"/></material></visual><collision><geometry><box size="0.18 0.05 0.05"/></geometry></collision><inertial><mass value="0.20"/><inertia ixx="0.00015" ixy="0" ixz="0" iyy="0.00015" iyz="0" izz="0.00015"/></inertial></link>
    <joint name="tilt_joint" type="revolute"><parent link="pan_link"/><child link="tilt_link"/><origin xyz="0.06 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-0.8" upper="0.8" effort="8" velocity="1.5"/><dynamics damping="0.05" friction="0.02"/></joint>

    <link name="laser_pointer_link"><visual><origin xyz="0.08 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.012" length="0.16"/></geometry><material name="laser_red"><color rgba="1 0 0 1"/></material></visual><collision><origin xyz="0.08 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.012" length="0.16"/></geometry></collision><inertial><mass value="0.06"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial></link>
    <joint name="laser_pointer_joint" type="fixed"><parent link="tilt_link"/><child link="laser_pointer_link"/><origin xyz="0.12 0 0" rpy="0 0 0"/></joint>
  </xacro:macro>
</robot>