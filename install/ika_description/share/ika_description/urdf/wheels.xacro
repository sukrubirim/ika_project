<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="cylinder_inertial" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass*(3*radius*radius+length*length)/12}" ixy="0" ixz="0"
        iyy="${mass*radius*radius/2}" iyz="0"
        izz="${mass*(3*radius*radius+length*length)/12}"/>
    </inertial>
  </xacro:macro>

  <!--
    Her teker için önce şaseden aşağı inen bir bacak/taşıyıcı kol oluşturulur.
    Tekerlek doğrudan base_link'e değil, bu bacak ucuna bağlanır.
  -->
  <xacro:macro name="ika_wheel" params="name parent x y z">
    <xacro:property name="wheel_center_z" value="${-ground_clearance + z}"/>
    <xacro:property name="leg_top_z" value="${-base_height/2}"/>
    <xacro:property name="leg_bottom_z" value="${wheel_center_z}"/>
    <xacro:property name="leg_length" value="${leg_top_z - leg_bottom_z}"/>
    <xacro:property name="leg_mid_z" value="${(leg_top_z + leg_bottom_z)/2}"/>

    <link name="${name}_leg_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.08 0.08 ${leg_length}"/>
        </geometry>
        <material name="leg_metal">
          <color rgba="0.32 0.32 0.32 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.08 0.08 ${leg_length}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>

    <joint name="${name}_leg_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_leg_link"/>
      <origin xyz="${x} ${y} ${leg_mid_z}" rpy="0 0 0"/>
    </joint>

    <!-- Teker bağlantı göbeği -->
    <link name="${name}_hub_link">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="0.07" length="0.16"/>
        </geometry>
        <material name="hub_gray">
          <color rgba="0.55 0.55 0.55 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="0.07" length="0.16"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="0.7" radius="0.07" length="0.16"/>
    </link>

    <joint name="${name}_hub_joint" type="fixed">
      <parent link="${name}_leg_link"/>
      <child link="${name}_hub_link"/>
      <origin xyz="0 0 ${-leg_length/2}" rpy="0 0 0"/>
    </joint>

    <link name="${name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="rubber">
          <color rgba="0.02 0.02 0.02 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="2.4" radius="${wheel_radius}" length="${wheel_width}"/>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="${name}_hub_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.20" friction="0.10"/>
    </joint>

    <transmission name="${name}_wheel_transmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${name}_wheel_joint">
        <hardwareInterface>velocity</hardwareInterface>
      </joint>
      <actuator name="${name}_wheel_motor">
        <hardwareInterface>velocity</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <gazebo reference="${name}_leg_link">
      <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="${name}_hub_link">
      <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="${name}_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>1.45</mu1>
      <mu2>1.45</mu2>
      <kp>1000000</kp>
      <kd>1</kd>
    </gazebo>
  </xacro:macro>
</robot>
