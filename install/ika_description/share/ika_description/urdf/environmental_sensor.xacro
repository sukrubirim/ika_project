<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="environmental_sensor" params="parent x y z">
    <link name="environmental_sensor_link">
      <visual><geometry><box size="0.05 0.05 0.03"/></geometry><material name="cyan"><color rgba="0 0.8 0.9 1"/></material></visual>
      <collision><geometry><box size="0.05 0.05 0.03"/></geometry></collision>
      <inertial><mass value="0.04"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
    </link>
    <joint name="environmental_sensor_joint" type="fixed"><parent link="${parent}"/><child link="environmental_sensor_link"/><origin xyz="${x} ${y} ${z}" rpy="0 0 0"/></joint>
    <!-- Gazebo Classic içinde BME280 için standart hazır plugin yok. Bu link gerçek/sim çevre node'unun frame'i olarak kullanılır. -->
  </xacro:macro>
</robot>
