<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="teknofest_autonomous_track">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="track_base">
      <static>true</static>
      <link name="road">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 3</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 3</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="left_barrier">
      <static>true</static>
      <pose>0 1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>100 0.1 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>100 0.1 0.8</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material> </visual>
      </link>
    </model>
    
    <model name="right_barrier">
      <static>true</static>
      <pose>0 -1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>100 0.1 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>100 0.1 0.8</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="water_trench">
      <static>true</static>
      <pose>10 0 -0.2 0 0 0</pose> <link name="link">
        <collision name="collision">
          <geometry><box><size>3 3 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 3 0.4</size></box></geometry>
          <material><ambient>0 0.3 0.8 0.5</ambient></material> </visual>
      </link>
    </model>

    <model name="gravel_road">
      <static>true</static>
      <pose>15 0 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4 3 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4 3 0.05</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="side_slope">
      <static>true</static>
      <pose>22 0 0.3 0.197 0 0</pose> <link name="link">
        <collision name="collision">
          <geometry><box><size>5 3 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 3 0.1</size></box></geometry>
          <material><ambient>0.6 0.6 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="vertical_obstacle">
      <static>true</static>
      <pose>30 0 0.075 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 3 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 3 0.15</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="cone_1">
      <static>true</static>
      <pose>35 0.5 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.75</size></box></geometry>
          <material><ambient>1 0.4 0 1</ambient></material>
        </visual>
      </link>
    </model>
    
    <model name="cone_2">
      <static>true</static>
      <pose>37 -0.5 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.75</size></box></geometry>
          <material><ambient>1 0.4 0 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="sliding_obstacle">
      <static>false</static>
      <pose>42 0 0.5 0 0 0</pose>

      <link name="link">
      <kinematic>true</kinematic> <!-- Added for fixing slide obstacle -->
        <gravity>false</gravity>    <!-- Added for fixing slide obstacle -->
        <inertial>
          <mass>20.0</mass>
          <inertia>
            <ixx>1.0</ixx>
            <iyy>1.0</iyy>
            <izz>1.0</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 1.0 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 1.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
          </material>
        </visual>
      </link>

      <plugin name="sliding_movement" filename="libgazebo_ros_planar_move.so">
        <ros>
          <namespace>/slider</namespace>
          <remapping>cmd_vel:=cmd_vel</remapping>
          <remapping>odom:=odom</remapping>
        </ros>

        <odometry_frame>slider_odom</odometry_frame>
        <robot_base_frame>link</robot_base_frame>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
      </plugin>
    </model>

    <model name="bump_1">
      <static>true</static>
      <pose>48 0 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 3 0.05</size></box></geometry></visual>
      </link>
    </model>
    
    <model name="bump_2">
      <static>true</static>
      <pose>48.5 0 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 3 0.05</size></box></geometry></visual>
      </link>
    </model>

    <model name="steep_hill_up">
      <static>true</static>
      <pose>53 0 0.5 0 -0.422 0</pose> <link name="link">
        <collision name="collision"><geometry><box><size>2.2 3 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 3 0.1</size></box></geometry></visual>
      </link>
    </model>

    <model name="steep_hill_flat">
      <static>true</static>
      <pose>54.5 0 0.95 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 3 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 3 0.1</size></box></geometry></visual>
      </link>
    </model>

    <model name="steep_hill_down">
      <static>true</static>
      <pose>56 0 0.5 0 0.422 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 3 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 3 0.1</size></box></geometry></visual>
      </link>
    </model>

    <model name="laser_target">
      <static>true</static>
      <pose>67 0 1.0 0 0 0</pose> <link name="link">
        <collision name="collision"><geometry><box><size>0.05 0.42 0.297</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.42 0.297</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material> </visual>
      </link>
    </model>

    <model name="acceleration_track">
      <static>true</static>
      <pose>0 10 0 0 0 0</pose> <link name="road">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 3</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 3</size></plane></geometry>
          <material><ambient>0.2 0.8 0.2 1</ambient></material> </visual>
      </link>
    </model>

  </world>
</sdf>